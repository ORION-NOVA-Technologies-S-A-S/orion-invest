# Copia este archivo como .env y llena los valores. NUNCA subas .env a GitHub.

# --- Base de datos PostgreSQL ---
POSTGRES_PASSWORD=cambia-esta-clave
# Solo si corres el backend sin Docker:
# DATABASE_URL=postgresql+psycopg://orion:cambia-esta-clave@localhost:5432/orion_invest

# --- Seguridad ---
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_HOURS=12
# true cuando la app esté detrás de HTTPS (producción)
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Alpaca (https://app.alpaca.markets) ---
# paper = dinero simulado | live = DINERO REAL
ALPACA_ENV=paper
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# iex es gratis; sip requiere suscripción de datos
ALPACA_STOCK_FEED=iex

# --- Controles de riesgo (USD) ---
TRADING_ENABLED=true
MAX_ORDER_USD=500
MAX_DAILY_USD=1500

# --- Puerto de la web en Docker ---
WEB_PORT=8080
